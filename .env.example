# Copy to .env: cp .env.example .env
# Set strong values for production. Do not commit .env.
#
# Images (built by build-image in each app repo):
#   docker.io/crraay/habit-tracker-springboot:latest
#   docker.io/crraay/habit-tracker-angular:latest

# PostgreSQL
POSTGRES_DB=habit_tracker
POSTGRES_USER=habit
POSTGRES_PASSWORD=change_me

# JWT signing key for HS256 (Base64). Generate: openssl rand -base64 48
JWT_SECRET=YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXowMTIzNDU=

# Include your public origin(s), e.g. http://YOUR_DROPLET_IP
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
